<?xml version="1.0"?>
<package format="3">
  <name>grace_controller</name>
  <version>0.0.0</version>
  <description>LQR balancing controller and supporting nodes for the GRACE robot</description>
  <maintainer email="muhammadanss0907@gmail.com">Muhammad Anss</maintainer>
  <license>Apache 2.0</license>
  <author email="muhammadanss0907@gmail.com">Muhammad Anss</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>ros2_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>